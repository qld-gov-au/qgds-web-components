{
  "extends": ["stylelint-config-standard-scss"],
  "plugins": ["stylelint-use-logical-spec"],
  "rules": {
    "scss/at-mixin-argumentless-call-parentheses": "always",
    "selector-type-no-unknown": [
      true,
      {
        "ignore": ["custom-elements"]
      }
    ],
    "scss/at-rule-no-unknown": true,
    "color-hex-length": null,
    "color-function-notation": "modern",
    "alpha-value-notation": "number",
    "import-notation": "string",
    "scss/load-no-partial-leading-underscore": true,
    "selector-pseudo-element-no-unknown": [
      true,
      {
        "ignorePseudoElements": ["part"]
      }
    ],
    "liberty/use-logical-spec": "always",
    "custom-property-pattern": [
      "^_?[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      {
        "message": "Expected custom property to be kebab-case"
      }
    ],
    "scss/dollar-variable-pattern": [
      "^_?[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      {
        "message": "Expected variable to be kebab-case, optionally prefixed with _ for private variables"
      }
    ],
    "scss/percent-placeholder-pattern": [
      "^_?[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      {
        "message": "Expected placeholder to be kebab-case, optionally prefixed with _ for private placeholders"
      }
    ]
  },
  "ignoreFiles": [
    "dist/**/*",
    "storybook-static/**/*",
    "node_modules/**/*",
    "coverage/**/*",
    "**/*.js",
    "**/*.ts"
  ]
}
