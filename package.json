{
  "name": "@qld-gov-au/qgds-web-components",
  "version": "0.2.0",
  "description": "Queensland Government Design System (QGDS) - Web Components",
  "repository": {
    "type": "git",
    "url": "https://github.com/qld-gov-au/qgds-web-components.git"
  },
  "type": "module",
  "main": "src/index.ts",
  "customElements": "custom-elements.json",
  "scripts": {
    "dev": "vite",
    "build": "npm run analyze && vite build",
    "serve": "http-server dist -p 8090",
    "analyze": "custom-elements-manifest analyze && node scripts/post-process-cem.js",
    "generate:icons": "node scripts/generate-icon-list.js",
    "test": "vitest --config vitest.config.ts",
    "test:ui": "vitest --config vitest.config.ts --ui",
    "test:coverage": "vitest --config vitest.config.ts --coverage",
    "test:storybook": "vitest --config vite.config.ts --project=storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --stats-json",
    "chromatic": "chromatic --build-script-name build-storybook",
    "lint": "npm run lint:ts && npm run lint:styles",
    "lint:ts": "eslint . --max-warnings 0",
    "lint:ts:fix": "eslint . --fix",
    "lint:styles": "stylelint \"src/**/*.{css,scss}\"",
    "lint:styles:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "lint:fix": "npm run lint:ts:fix && npm run lint:styles:fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^9.39.1",
    "@storybook/addon-a11y": "^10.1.2",
    "@storybook/addon-docs": "^10.1.2",
    "@storybook/addon-vitest": "^10.1.2",
    "@storybook/web-components-vite": "^10.1.2",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^24.10.1",
    "@vitest/browser-playwright": "^4.0.14",
    "@vitest/coverage-v8": "^4.0.14",
    "@wc-toolkit/storybook-helpers": "^10.0.0",
    "@wc-toolkit/type-parser": "^1.2.0",
    "chromatic": "^13.3.4",
    "eslint": "^9.39.1",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-lit": "^2.1.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "eslint-plugin-wc": "^3.0.2",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.6.2",
    "sass": "^1.70.0",
    "storybook": "^10.1.10",
    "stylelint": "^16.26.1",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-use-logical-spec": "^5.0.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^4.0.14"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "lit": "^3.3.1"
  }
}
