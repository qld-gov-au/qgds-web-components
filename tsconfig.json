{
  "compilerOptions": {
    "target": "ES2017", // Good balance for modern browsers and bundlers
    "module": "ESNext", // Lets bundlers optimize modules
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "downlevelIteration": true, // Ensures correct transpilation of iterators/for..of
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src",
    "build.ts",
    "src/types/global.d.ts",
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}